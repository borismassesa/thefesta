{
  "name": "opusfesta",
  "version": "1.0.0",
  "description": "Tanzania's go-to wedding & events marketplace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:website": "turbo dev --filter=./apps/website",
    "dev:landing": "turbo dev --filter=./apps/opus_website",
    "dev:customersupport": "turbo dev --filter=./apps/customersupport",
    "build:website": "turbo build --filter=./apps/website",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "postinstall": "node scripts/cleanup-vendor-react.js",
    "check:prepush": "bash scripts/prepush-check.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:website": "bash scripts/deploy.sh website",
    "deploy:admin": "bash scripts/deploy.sh admin",
    "deploy:pass": "bash scripts/deploy.sh pass",
    "deploy:vendors": "bash scripts/deploy.sh vendors",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "db:run:sql": "node scripts/run-sql-migration.js",
    "cleanup:duplicates": "tsx scripts/cleanup-duplicate-users.ts",
    "cleanup:duplicates:dry-run": "tsx scripts/cleanup-duplicate-users.ts --dry-run",
    "cleanup:vendor-duplicates": "tsx scripts/cleanup-duplicate-vendors.ts",
    "cleanup:vendor-duplicates:dry-run": "tsx scripts/cleanup-duplicate-vendors.ts --dry-run"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0",
    "zod-validation-error": "^4.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.7.0",
  "overrides": {
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.25",
    "lenis": "^1.3.21",
    "next": "15.5.12",
    "tailwind-merge": "^3.4.0"
  }
}
