# OpusFesta Supabase project (shared with opus_website)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — keep out of NEXT_PUBLIC_*. Used for admin writes that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — MUST be the ONE shared production instance for the whole
# *.opusfesta.com apex (website + opuspass + vendors_portal + admin all use
# the SAME pk_live/sk_live). This is not optional: Clerk scopes its
# __client_uat / __session cookies to the registrable domain (opusfesta.com)
# and shares them across every subdomain. If admin runs a *different* Clerk
# instance than the other apps, the two clobber the shared apex cookie and
# admin's sign-in spins forever (clerk-js sees a __client_uat with no session
# for its instance → endless handshake loop). Use pk_live/sk_live ONLY here —
# a pk_test in production also poisons the shared cookie.
#
# Admin authorization does NOT depend on the Clerk instance: (admin)/layout.tsx
# gates on admin_whitelist (source of truth) and redirects non-staff to
# /contribute. So sharing one auth instance never grants customers admin access.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Set to `true` to TEMPORARILY bypass the entire admin sign-in/role gate
# during development — every caller is treated as an `owner`. Ignored entirely
# when NODE_ENV=production, so it can never open the admin in a prod build even
# if accidentally set. Leave unset everywhere. See proxy.ts + lib/admin-auth.ts.
DISABLE_ADMIN_AUTH=

# Admin app URL — used for self-referential links and revalidation callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Public site URL — used to revalidate opus_website pages on publish
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3007
WEBSITE_REVALIDATE_SECRET=

# OpusPass door-staff scanner URL — used to build the shareable link shown
# to admins when they assign a scanning attendant (Operations > Event Check-in).
# Base URL of the door-staff scanner UI on opus_pass (includes the
# /entrance-card-scanner path prefix). Admin share links append `/event/{id}?token=…`.
# Dev: http://localhost:3008/entrance-card-scanner
# Prod: https://opuspass.opusfesta.com/entrance-card-scanner
NEXT_PUBLIC_OPUS_SCANNER_URL=http://localhost:3008/entrance-card-scanner

# Vendors portal URL — used to deep-link vendor lifecycle notification
# emails (approval / corrections / suspension) to the right portal page,
# AND to revalidate the vendors portal's ISR cache when admins publish
# changes from /cms/vendors-portal/*.
NEXT_PUBLIC_VENDORS_PORTAL_URL=http://localhost:3003
# Must match VENDORS_PORTAL_REVALIDATE_SECRET in the vendors_portal app.
# Without this, "Publish" in vendors-portal CMS sections will only update the
# database — public pages will keep serving stale ISR content until redeploy.
VENDORS_PORTAL_REVALIDATE_SECRET=

# Resend transactional email — contributor invites, future admin emails.
# Leave RESEND_API_KEY empty to fall back to a mailto: link in the admin UI.
# RESEND_FROM_EMAIL must be on a domain verified at https://resend.com/domains.
# For local development before verification, use Resend's built-in testing
# sender — note it only delivers to the Resend account owner's email:
#   RESEND_FROM_EMAIL=OpusFesta <onboarding@resend.dev>
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpusFesta <admin@opusfesta.com>

# Where editorial submission notifications are sent. Comma-separated for
# multiple recipients. Leave empty to skip the email (the submission still
# lands in the admin Submissions tab regardless).
EDITORIAL_NOTIFY_EMAIL=editorial@opusfesta.com

# Shared secret checked by /api/md-tracker/nudge (the daily "you missed
# yesterday's entry" email). Must match app.settings.md_tracker_cron_secret
# on the Supabase project — see 20260701000009_md_tracker_nudge_cron.sql.
MD_TRACKER_CRON_SECRET=

# Workspace maintenance endpoints. Each value must match the encrypted secret
# with the corresponding lowercase name in Supabase Vault:
# attendance_cron_secret, reports_cron_secret, tracker_cron_secret and
# leave_cron_secret. Keep these server-only; never add NEXT_PUBLIC_.
ATTENDANCE_CRON_SECRET=
REPORTS_CRON_SECRET=
TRACKER_CRON_SECRET=
LEAVE_CRON_SECRET=

# Finance/customer transactional emails. FINANCE_EMAIL is used as a shared
# finance inbox in admin flows; OpusPass also uses it as a fallback recipient
# for invitation payment review notifications.
FINANCE_EMAIL=finance@opusfesta.com

# ─── OpusPass couple accounts ───────────────────────────────────────────────
# Secret key of the Clerk application serving clerk.opusfesta.com — where
# couples sign in (opuspass.opusfesta.com + www.opusfesta.com). Used to create a
# couple's sign-in login and to remove it when their account is deleted.
#
# NOT this app's CLERK_SECRET_KEY (that is clerk.admin.opusfesta.com, where staff
# sign in) and NOT VENDORS_CLERK_SECRET_KEY: the Clerk org runs four separate
# applications — OpusFesta, OpusFesta Vendors, OpusFesta Admin, OpusStudio — so
# each of those keys reaches a different set of users. There is no fallback, on
# purpose: a wrong instance would create logins that silently do not work.
PLATFORM_CLERK_SECRET_KEY=

# Signs the short-lived token that lets staff open a couple's OpusPass
# dashboard as that couple. MUST match COUPLE_STAFF_ACCESS_SECRET in
# apps/opus_pass or the link will not verify. Leave empty to disable the
# feature (the button reports it as unavailable).
COUPLE_STAFF_ACCESS_SECRET=
