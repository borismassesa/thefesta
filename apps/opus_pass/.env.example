# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Supabase (server) ───────────────────────────────────────────────────────
# Required by the payments order ledger (invitation_orders). The service-role
# key is server-only — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# ─── Payments: Selcom (Tanzania) ─────────────────────────────────────────────
# Feature flag for the automated Selcom flows (M-Pesa STK push + card). Leave
# unset/false until a Selcom merchant account + SELCOM_* creds exist: checkout
# then shows ONLY the manual Lipa Namba flow (customer pays, enters their
# reference, team confirms). Set to "true" to enable push + card.
NEXT_PUBLIC_PAYMENTS_SELCOM_ENABLED="false"

# Selcom Checkout API credentials. Sandbox values for dev; live values on prod.
# The webhook (set in the Selcom dashboard) must point to
#   <NEXT_PUBLIC_OPUS_PASS_URL>/api/payments/webhook
SELCOM_BASE_URL="https://apigwtest.selcommobile.com/v1"   # live: https://apigw.selcommobile.com/v1
SELCOM_API_KEY="MY_SELCOM_API_KEY"
SELCOM_API_SECRET="MY_SELCOM_API_SECRET"
SELCOM_VENDOR_ID="MY_SELCOM_VENDOR_ID"

# Public origin of the OpusPass app — used to build the Selcom redirect/webhook
# URLs. Must be the publicly reachable HTTPS URL in production.
NEXT_PUBLIC_OPUS_PASS_URL="https://opuspass.opusfesta.com"

# Public origin of the OpusFesta marketplace site (opus_website). Used by the
# dashboard chrome to link to the marketplace and the couple's vendor inquiries
# (<URL>/my/inquiries). Defaults to http://localhost:3006 for local dev.
NEXT_PUBLIC_SITE_URL="https://opusfesta.com"

# ─── Transactional email: invitation payment review ─────────────────────────
# RESEND_API_KEY must be set in production for invoice/review emails.
# INVITATION_PAYMENTS_ADMIN_EMAIL can be comma-separated for multiple finance
# recipients. FINANCE_EMAIL is the fallback used by payment emails.
RESEND_API_KEY="MY_RESEND_API_KEY"
RESEND_FROM_EMAIL="OpusFesta <admin@opusfesta.com>"
INVITATION_PAYMENTS_ADMIN_EMAIL="finance@opusfesta.com"
FINANCE_EMAIL="finance@opusfesta.com"

# ─── WhatsApp Business (Meta Cloud API) ─────────────────────────────────────
# When these are set the app sends real invitation template messages; when
# unset it falls back to a dry-run stub that logs but does not send.
#   WHATSAPP_PHONE_NUMBER_ID        from the Meta WhatsApp number
#   WHATSAPP_ACCESS_TOKEN           system-user permanent token (whatsapp_business_messaging)
#   WHATSAPP_TEMPLATE_NAME          approved template (image header + {{1}} body + 3 quick-reply buttons)
#   WHATSAPP_TEMPLATE_LANG          template language code (e.g. sw)
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN   arbitrary secret echoed in the webhook GET handshake
#   WHATSAPP_APP_SECRET             Meta app secret; signs inbound webhook POSTs
#                                   (X-Hub-Signature-256). When set, unsigned or
#                                   mismatched POSTs are rejected. Leave unset in
#                                   dev to skip verification.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="sw"
# Contact Collector / Pledge link-request templates (dynamic-URL button each);
# unset means that specific send kind reports "not configured".
WHATSAPP_TEMPLATE_NAME_COLLECTOR=""
WHATSAPP_TEMPLATE_LANG_COLLECTOR="sw"
WHATSAPP_TEMPLATE_NAME_PLEDGE=""
WHATSAPP_TEMPLATE_LANG_PLEDGE="sw"
WHATSAPP_TEMPLATE_NAME_ENTRANCE_PASS=""
WHATSAPP_TEMPLATE_LANG_ENTRANCE_PASS="sw"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ─── Personalised invitation-card media ────────────────────────────────────
# HMAC secret used to derive the stable, unguessable URL Meta fetches for each
# guest's prepared PNG. Generate with:
#   openssl rand -base64 48
# Changing CURRENT invalidates newly derived URLs; retain the former value as
# PREVIOUS during a two-deploy rotation window. Never expose either to clients.
CARD_ASSET_TOKEN_SECRET_CURRENT=""
CARD_ASSET_TOKEN_SECRET_PREVIOUS=""
# Non-production smoke route only; deliberately separate from the asset key.
CARD_DELIVERY_SMOKE_SECRET=""

# ─── Guest entrance-pass QR (check-in) ──────────────────────────────────────
# LEGACY. Signs/verifies the HMAC token embedded in tickets issued before
# opaque credentials. Still required while those tickets are inside their
# compatibility window (see ADMISSION_CREDENTIAL_KEYS below); removing it
# early breaks every pass already sitting in a guest's WhatsApp thread.
CHECKIN_TOKEN_SECRET=""

# ─── Admission credentials (opaque OP1 QR payloads) ─────────────────────────
# New tickets carry an opaque random credential instead of a decodable signed
# payload. Only SHA-256(credential) is used for lookup; the raw value is kept
# under AES-256-GCM so a ticket can be redrawn without rotating it, which is
# what these keys protect.
#
# JSON object of key version to a base64 32-byte key:
#   ADMISSION_CREDENTIAL_KEYS='{"1":"<base64 32 bytes>"}'
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Every listed version stays readable, so a key can be retired without
# invalidating tickets already issued under it. Keep these in the secrets
# manager, never in the repo.
#
# Unset, ticket rendering falls back to the legacy signed token and shouts in
# the logs. That is a rollout safety valve, not a supported configuration.
ADMISSION_CREDENTIAL_KEYS=""
# Which version new credentials are written with. Defaults to the highest
# version present in ADMISSION_CREDENTIAL_KEYS.
ADMISSION_CREDENTIAL_KEY_VERSION="1"

# ─── Google Wallet entry pass ───────────────────────────────────────────────
# Lets a guest save their entry pass to Google Wallet. The pass is a VIEW of the
# admission, never a second ticket: the door validates the OP1 credential, and
# the wallet holds a copy of it.
#
# Off unless GOOGLE_WALLET_ENABLED is exactly "true". Any other value, or any
# missing variable below, withholds the button rather than failing on tap.
#
# Issuance calls the Google Wallet REST API, so the service account MUST hold
# the Developer role on the issuer in the Google Pay & Wallet Console. Without
# it every issue fails with class_http_403. Full runbook:
#   docs/OPUSPASS_WALLET_PROVIDER_SETUP.md
GOOGLE_WALLET_ENABLED="false"
# From the Pay & Wallet Console, the numeric issuer id.
GOOGLE_WALLET_ISSUER_ID=""
# `client_email` from the service-account JSON.
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
# `private_key` from the same JSON. Keep the literal \n escapes; they are
# expanded before use, because Vercel's value box is a single line.
GOOGLE_WALLET_PRIVATE_KEY=""

# ─── Staff dashboard access ─────────────────────────────────────────────────
# Verifies the token admin mints when a staff member opens a couple's dashboard
# as that couple (Couple Accounts → Open dashboard). MUST match
# COUPLE_STAFF_ACCESS_SECRET in apps/opus_admin. Leave empty to refuse every
# staff-access link.
COUPLE_STAFF_ACCESS_SECRET=""

# ── SMS gateway (Beem Africa) ────────────────────────────────────────────────
# Server-only. None of these may ever take a NEXT_PUBLIC_ prefix: that inlines
# the value into JavaScript served to every visitor.
#
# Two independent switches must both be on before a real SMS is sent. Leave
# SMS_PROVIDER unset and every surface stays on the dry-run stub, exactly as it
# behaves today.
SMS_PROVIDER=""                       # "beem" selects the live gateway; anything else = stub

# Per-surface opt-in. Each surface is separate on purpose: pledge sends ask a
# guest for money and admin sends act on someone else's roster, so neither
# should go live as a side effect of launching invitations. Only the literal
# string "true" enables one.
SMS_BEEM_INVITATIONS_ENABLED="false"  # guest invitations + entrance codes
SMS_BEEM_PLEDGES_ENABLED="false"      # couple's own pledge requests/reminders
SMS_BEEM_ADMIN_PLEDGES_ENABLED="false" # staff-triggered pledge sends (Pledge Concierge)
SMS_BEEM_COMMISSIONS_ENABLED="false"  # commission-service notifications

# Credentials. All three are required; if any is missing the app stays on the
# stub rather than reporting itself live and failing every send.
#   SMS_BEEM_API_KEY      Basic-auth username, from the Beem dashboard
#   SMS_BEEM_SECRET_KEY   Basic-auth password
#   SMS_BEEM_SENDER_ID    registered sender name, max 11 chars (e.g. OpusPass).
#                         Registration takes ~7-14 working days and must be
#                         approved before any send will be delivered.
SMS_BEEM_API_KEY=""
SMS_BEEM_SECRET_KEY=""
SMS_BEEM_SENDER_ID="OpusPass"
SMS_BEEM_BASE_URL="https://apisms.beem.africa"
SMS_BEEM_TIMEOUT_MS="15000"

# TEMPORARY, for the one-off live-validation pass only. Logs the whole
# (still redacted) gateway response so the real payload shape can be written
# into a test fixture. Turn back OFF once that fixture exists: a response body
# can carry recipient numbers, routing detail and echoed request fields, and
# redacting only the secrets we know about is no defence against fields we
# have never seen.
SMS_BEEM_DEBUG_RESPONSE_ENABLED="false"

# ── Admin single-recipient test send ─────────────────────────────────────────
# /api/internal/admin/sms/test-send takes a destination and an arbitrary body,
# so whoever holds this secret can send any text to any Tanzanian number at our
# expense and under our approved sender name. That is NOT the same power as
# cache revalidation, so it has its own credential rather than reusing
# OPUS_PASS_REVALIDATE_SECRET.
#
# The route is 404 unless the switch is on, so a leaked secret is inert while
# it is off. Turn it on for validation, then off again. Callers must also send
# an `x-opus-actor` header naming the operator; it is recorded with every
# outcome and rate-limited per actor (10/hour).
SMS_BEEM_TEST_SEND_ENABLED="false"
OPUS_PASS_SMS_TEST_SECRET=""
